# .env.prod.example
#
# AWS EC2 배포용 템플릿. 복사해서 .env.prod 로 이름을 바꾸고 값을 채운다.
#     cp .env.prod.example .env.prod
#
# .env.prod 는 .gitignore 의 .env.* 규칙에 걸려 커밋되지 않는다.
#
# 실행:
#     docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# 아래 항목 중 :? 로 표시된 것(POSTGRES_*, SESSION_SECRET)은 비워두면 컨테이너가
# 아예 뜨지 않는다. 로컬 구성처럼 조용히 기본값으로 넘어가지 않는다 — 개발용
# 비밀번호로 배포되는 사고를 막기 위해서다.

# ---------------------------------------------------------------------------
# DB (필수)
# ---------------------------------------------------------------------------
# 비밀번호 생성:
#     openssl rand -base64 24
#
# 주의: 볼륨이 비어 있을 때(최초 기동)만 반영된다. 이미 초기화된 뒤에 바꾸면
# 앱은 새 비밀번호로 접속하는데 DB 에는 옛 비밀번호가 남아 인증에 실패한다.
POSTGRES_USER=cloudedx
POSTGRES_PASSWORD=
POSTGRES_DB=cloudedx

# ---------------------------------------------------------------------------
# 세션 (필수)
# ---------------------------------------------------------------------------
# 백엔드 3대가 같은 키로 쿠키를 서명해야 한다. 비워두면 각자 임의 키를 만들어
# 요청이 어느 컨테이너로 가느냐에 따라 로그인이 풀린다.
#     python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# 로그인 유지 시간(초). 기본 12시간.
SESSION_MAX_AGE_SECONDS=43200

# ---------------------------------------------------------------------------
# 이미지
# ---------------------------------------------------------------------------
# prod 구성은 build 하지 않고 이미 만들어진 이미지를 쓴다. 배포 서버에서
# 빌드하면 소스가 서버에 올라가야 하고, EC2 t3.small 에서 Playwright 이미지를
# 굽는 데 몇 분씩 걸린다.
#
# CI 에서 GHCR 에 올리기 전까지는 로컬에서 빌드해 저장한 뒤 서버로 옮긴다:
#     docker compose build
#     docker save cloudedx-backend:latest | gzip > backend.tar.gz
#     scp backend.tar.gz ec2-user@<IP>:~/
#     ssh ec2-user@<IP> "docker load < backend.tar.gz"
#
# GHCR 을 붙인 뒤에는 이렇게 바뀐다:
#     BACKEND_IMAGE=ghcr.io/epqlffltm/cloudedx-backend:main
#     CRAWLER_IMAGE=ghcr.io/epqlffltm/cloudedx-crawler:main
BACKEND_IMAGE=cloudedx-backend:latest
CRAWLER_IMAGE=cloudedx-crawler:latest

# ---------------------------------------------------------------------------
# 네트워크
# ---------------------------------------------------------------------------
# uvicorn 이 X-Forwarded-For 를 믿어줄 대역. docker-compose.prod.yml 에서
# 고정한 서브넷과 일치해야 한다.
#
# ALB 를 앞에 두는 구성으로 바꾸면 여기에 VPC 서브넷 대역도 함께 넣는다:
#     FORWARDED_ALLOW_IPS=172.28.0.0/16,10.0.0.0/16
FORWARDED_ALLOW_IPS=172.28.0.0/16

# 브라우저가 화면과 API 를 같은 출처로 보므로 보통 비워둔다.
# 프론트를 별도 도메인/CDN 에 올릴 때만 채운다.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# 크롤러
# ---------------------------------------------------------------------------
# 상대 서버에 부담을 주지 않는 선을 지킨다. 배포에서 주기를 짧게 잡으면
# 차단당할 위험이 실제로 있다.
CRAWL_INTERVAL_MINUTES=30
CRAWL_RETRY_MINUTES=5
CRAWL_RUN_TIMEOUT_MINUTES=60
JOONGNA_PAGES_PER_BRAND=3
BUNJANG_PAGES_PER_JOB=3
MISSING_THRESHOLD=3

# ---------------------------------------------------------------------------
# 로깅
# ---------------------------------------------------------------------------
# LOG_FORMAT 은 compose 에서 json 으로 고정하므로 여기서 설정하지 않는다.
LOG_LEVEL=INFO

# CSV 업로드 최대 바이트. nginx 의 client_max_body_size 와 맞춰야 한다.
MAX_UPLOAD_BYTES=5242880
