# .env.migrate.example
#
# 운영 서버에서 배포 스크립트가 쓴다.
#
#     docker compose -f docker-compose.migrate.yml --env-file .env.migrate \
#         run --rm migrate

# 웹·크롤러와 같은 DB. 마이그레이션은 쓰기이므로 주 DB 를 가리켜야 한다
# (Route 53 레코드가 그 역할을 한다).
DATABASE_URL=postgresql+asyncpg://cloudedx:<비밀번호>@db.reluxe.internal:5432/cloudedx

BACKEND_IMAGE=reluxe-backend:latest

LOG_LEVEL=INFO
