# nginx/Dockerfile
#
# 설정을 이미지에 구워 넣는다. 바인드 마운트를 쓰지 않는 이유는 두 가지다.
#
# 첫째, Docker Desktop for Windows 에서 단일 파일 바인드 마운트가 불안정하다.
# 마운트가 한 번 실패하면 도커가 그 경로에 빈 디렉토리를 만들어 두는데, 호스트
# 파일을 고쳐도 컨테이너 안에서는 계속 디렉토리로 보인다. 컨테이너를 지우고
# 다시 만들어도 남아 있어서 원인을 찾기 어렵다.
#
# 둘째, 배포에서 이미지 하나만 옮기면 된다. EC2 에 설정 파일을 따로 scp 하고
# 경로를 맞출 필요가 없다. 설정이 바뀌면 이미지를 다시 굽는다 — 설정에도
# 코드와 같은 버전이 붙는다는 뜻이라, 롤백을 이미지 태그로 처리할 수 있다.

FROM nginx:1.27-alpine

# conf.d/default.conf 는 기본 이미지에 들어 있는 예제 설정이다. 같은 이름으로
# 덮어써서 예제가 함께 로드되는 일이 없게 한다.
COPY nginx.conf /etc/nginx/conf.d/default.conf
