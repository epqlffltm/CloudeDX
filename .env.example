# .env.example
#
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채워 쓴다.
#   Windows PowerShell:  copy .env.example .env
# .env 자체는 .gitignore에 걸려 있어서 커밋되지 않는다.

# ---------------------------------------------------------------------------
# DB 접속 정보 (로컬에서 uv run 으로 직접 실행할 때)
# ---------------------------------------------------------------------------
# docker compose up -d 로 띄운 Postgres에 호스트에서 붙는 주소다.
# localhost 대신 127.0.0.1을 쓰는 이유: Windows + Docker Desktop 조합에서
# localhost가 IPv6(::1)로 먼저 풀려 연결이 거부되는 경우가 있어서 IPv4를 강제한다.
#
# 컨테이너로 실행할 때(docker compose up)는 이 값이 쓰이지 않는다.
# compose가 각 서비스에 host=db 로 된 주소를 직접 주입한다.
DATABASE_URL=postgresql+asyncpg://cloudedx:cloudedx@127.0.0.1:5432/cloudedx

# 호스트 쪽 DB 포트. 5432가 이미 점유돼 있으면 여기만 바꾸고
# 위 DATABASE_URL의 포트도 똑같이 맞춰준다. 컨테이너 내부 포트는 항상 5432로 고정.
# Windows에서 netstat에는 안 잡히는데 바인딩이 거부되면 Hyper-V가 예약한 구간일 수 있다.
#   netsh interface ipv4 show excludedportrange protocol=tcp
DB_PORT=5432

# 백엔드 컨테이너를 호스트에 노출할 포트.
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# 크롤러
# ---------------------------------------------------------------------------
# false로 두면 백엔드 프로세스가 크롤러를 시작하지 않는다.
# compose로 띄울 때는 크롤러가 별도 컨테이너라 백엔드 쪽은 항상 false다.
ENABLE_CRAWLER=true

# 수집 주기(분). 사이트 부하와 봇 감지를 감안하면 너무 짧게 잡지 않는 게 좋다.
CRAWL_INTERVAL_MINUTES=30

# 라운드가 통째로 실패했을 때 다음 시도까지의 대기(분).
CRAWL_RETRY_MINUTES=5

# 이 시간을 넘겨 'running'으로 남은 수집 기록은 죽은 것으로 본다(분).
# 크롤러가 강제 종료되면 종료 시각을 못 남기는데, 그대로 믿으면 영원히 "수집 중"이 된다.
CRAWL_RUN_TIMEOUT_MINUTES=60

# 중고나라 브랜드당 수집 페이지 수.
JOONGNA_PAGES_PER_BRAND=3

# 번개장터 검색 잡당 API 페이지 수. 브라우저를 쓰지 않아 페이지당 비용이 가장 싸다.
BUNJANG_PAGES_PER_JOB=3

# 몇 번 연속으로 발견되지 않으면 매물을 비활성으로 볼지.
# 한 라운드 안 보였다고 판단하면 오탐이 잦다 — 30분 주기 기준 3회면 1시간 30분이다.
MISSING_THRESHOLD=3

# ---------------------------------------------------------------------------
# DB 자격증명 (컨테이너)
# ---------------------------------------------------------------------------
# compose가 db 컨테이너 초기화와 앱 접속 문자열 조립에 함께 쓴다.
# 위의 DATABASE_URL은 호스트에서 uv run 으로 직접 띄울 때만 쓰이고,
# 컨테이너로 띄울 때는 아래 세 값으로 조립된 주소가 주입된다.
#
# 주의: 이 값들은 볼륨이 비어 있을 때(최초 기동)만 반영된다. 이미 초기화된
# 뒤에 바꾸면 앱은 새 비밀번호로 접속하는데 DB에는 옛 비밀번호가 남아 있어
# 인증에 실패한다. 바꾸려면 볼륨째 지운다:  docker compose down -v
POSTGRES_USER=cloudedx
POSTGRES_PASSWORD=cloudedx
POSTGRES_DB=cloudedx

# ---------------------------------------------------------------------------
# 세션
# ---------------------------------------------------------------------------
# 세션 쿠키 서명 키. 비워두면 프로세스마다 임의로 생성되므로 재시작할 때마다
# 로그인이 풀리고, 백엔드를 여러 대로 띄우면 서로의 쿠키를 인정하지 않는다.
# compose에 시연용 고정 기본값이 있어 비워둬도 동작하지만, 값을 넣으면 그쪽이
# 우선한다.
#     python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# 로그인 유지 시간(초). 기본 12시간.
SESSION_MAX_AGE_SECONDS=43200

# CSV 업로드 한 번에 받을 최대 바이트. 기본 5MB.
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# 프론트엔드를 별도 개발 서버로 띄울 때 허용할 출처를 쉼표로 나열한다.
# 비워두면 CORS 미들웨어를 아예 붙이지 않는다 (프론트가 없는 동안의 기본 상태).
# 예: ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# 로깅
# ---------------------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# text = 사람이 읽는 형식(로컬), json = 한 줄 JSON(배포).
# CloudWatch Logs Insights나 Loki가 필드 단위로 질의하려면 json이 필요하다.
LOG_FORMAT=text
