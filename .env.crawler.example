# .env.crawler.example
#
# 크롤링 인스턴스 한 대에서만 쓴다.
#
#     docker compose -f docker-compose.crawler.yml --env-file .env.crawler up -d

# ---------------------------------------------------------------------------
# DB (필수)
# ---------------------------------------------------------------------------
# 웹 계층과 같은 값. 이쪽은 쓰기 주체다.
DATABASE_URL=postgresql+asyncpg://cloudedx:<비밀번호>@db.reluxe.internal:5432/cloudedx

# ---------------------------------------------------------------------------
# 이미지
# ---------------------------------------------------------------------------
CRAWLER_IMAGE=reluxe-crawler:latest

# ---------------------------------------------------------------------------
# 수집 (상대 서버에 부담을 주지 않는 선을 지킨다)
# ---------------------------------------------------------------------------
# 주기를 짧게 잡으면 차단당할 위험이 실제로 있다. NAT 고정 IP 로 나가므로
# 요청 주체가 식별된다는 점도 감안한다.
CRAWL_INTERVAL_MINUTES=30

# 라운드 전체가 실패했을 때 다음 시도까지의 간격.
CRAWL_RETRY_MINUTES=5

# 한 라운드가 이 시간을 넘으면 중단한다. 무한 대기로 다음 라운드가 밀리는 것을 막는다.
CRAWL_RUN_TIMEOUT_MINUTES=60

# 브랜드당 페이지 수. 늘리면 수집량과 소요 시간이 함께 는다.
JOONGNA_PAGES_PER_BRAND=3

# 번개장터는 브라우저를 쓰지 않아 페이지당 비용이 가장 싸다.
BUNJANG_PAGES_PER_JOB=3

# 몇 번 연속으로 발견되지 않으면 매물을 비활성으로 볼지.
# 30분 주기 기준 3회면 1시간 30분이다. 한 라운드 안 보였다고 판단하면 오탐이 잦다.
MISSING_THRESHOLD=3

# ---------------------------------------------------------------------------
# 기타
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
