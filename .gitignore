# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/

# Environment variables
.env
.env.*
# 값이 비어 있는 템플릿만 예외로 되살린다. .env.* 규칙이 실제 시크릿이 든
# .env / .env.prod / .env.web 등을 계속 막아주고, example 만 통과한다.
!.env.example
!.env.prod.example
!.env.web.example
!.env.crawler.example
!.env.migrate.example

# IDE
.idea/
.vscode/

# Test/cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# 크롤러 부산물. DB가 정본이라 없어도 동작한다 — 디버깅용으로만 남긴다.
# 폴더 자체는 유지해야 크롤러가 저장할 때 실패하지 않는다.
data/*
!data/.gitkeep

# 디버그 스크립트가 남기는 스크린샷
*.png
!app/templates/**/*.png

# Node
node_modules/

# 프론트엔드는 web/ 아래에만 둔다. 루트에 같은 이름이 다시 생기면
# 어느 쪽이 현행인지 알 수 없어진다 (ReLuxeV4 교체 때 실제로 겪음).
/index.html
/css/
/js/
/test/

# 루트로 떨어지는 데이터 덤프
/*.csv

# 프론트는 번들 없이 소스를 그대로 서빙한다. Vite 산출물이 다시 들어오면
# 어느 쪽이 실제로 로드되는지 알 수 없어진다.
/web/assets/