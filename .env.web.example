# .env.web.example
#
# 웹서버 3대에 배포한다. 복사해서 .env.web 으로 이름을 바꾸고 값을 채운다.
#
#     docker compose -f docker-compose.web.yml --env-file .env.web up -d
#
# 3대가 같은 값을 써야 하는 항목: DATABASE_URL, SESSION_SECRET

# ---------------------------------------------------------------------------
# DB (필수)
# ---------------------------------------------------------------------------
# Route 53 프라이빗 호스팅 영역의 이름을 쓴다. 주 DB 장애로 대기 DB 를 승격하면
# 그 레코드만 바꾸면 되고, 이 파일은 건드리지 않는다.
#
# 조립하지 않고 통째로 넣는 이유가 이것이다 — 호스트만 바뀌는 게 아니라
# "어디를 가리키는지"를 DNS 에 위임하기 위해서다.
DATABASE_URL=postgresql+asyncpg://cloudedx:<비밀번호>@db.reluxe.internal:5432/cloudedx

# ---------------------------------------------------------------------------
# 세션 (필수 · 3대 동일)
# ---------------------------------------------------------------------------
# 로그인 상태는 서버에 저장되지 않고 HMAC 서명 쿠키에만 담긴다. 그래서 ALB
# 스티키 세션은 필요 없지만, 그것은 3대가 같은 키로 서명한다는 전제 위에서만
# 성립한다. 키가 다르면 요청이 다른 서버로 갈 때마다 로그인이 풀린다.
#
#     openssl rand -hex 32
SESSION_SECRET=

# 로그인 유지 시간(초). 기본 12시간.
SESSION_MAX_AGE_SECONDS=43200

# ---------------------------------------------------------------------------
# 이미지
# ---------------------------------------------------------------------------
# ECR 을 붙이면 태그를 커밋 해시로 둔다. 어느 커밋이 떠 있는지 확인할 수 있고
# 롤백이 태그 교체로 끝난다.
#     WEB_IMAGE=<계정>.dkr.ecr.ap-northeast-2.amazonaws.com/reluxe-web:<커밋해시>
WEB_IMAGE=reluxe-web:latest
BACKEND_IMAGE=reluxe-backend:latest

# ---------------------------------------------------------------------------
# 네트워크
# ---------------------------------------------------------------------------
# X-Forwarded-For 를 믿어줄 대역. nginx 를 걷어내 체인이 한 단계다:
#   클라이언트 → ALB(VPC 대역) → uvicorn
# ALB 의 사설 IP 가 속한 VPC 대역만 신뢰하면 된다. 실제 값으로 바꾼다.
FORWARDED_ALLOW_IPS=10.0.0.0/16

# 화면과 API 를 같은 출처에서 내보내므로 보통 비워둔다.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# 기타
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880

# --- 실행 환경 (필수) ---
# 이 값이 production 이어야 비밀값 미설정 시 기동을 거부한다.
APP_ENV=production

# --- 읽기 복제본 ---
# RDS 읽기 복제본 엔드포인트. 주 DB가 페일오버하는 동안 조회를 여기서 받는다.
# 비워두면 DATABASE_URL 로 떨어지고, 그러면 복제본을 만들어도 아무도 안 쓴다.
DATABASE_RO_URL=postgresql+asyncpg://cloudedx:<비밀번호>@db-ro.reluxe.internal:5432/cloudedx

# --- 계정 (필수) ---
# 기본값(admin1234/client1234)은 로컬 전용이다. 여기 비우면 compose 가 멈춘다.
ADMIN_PASSWORD=<관리자 비밀번호>
CLIENT_PASSWORD=<기업고객 비밀번호>
# client 계정이 올린 매물을 연결할 판매자. seed 의 1번(청담 명품관).
CLIENT_SELLER_ID=1

# --- DB 연결 암호화 ---
# RDS 면 require. EC2 자체 postgres 가 TLS 를 안 켰으면 prefer.
DATABASE_SSL_MODE=prefer

# --- 이미지 저장소 ---
# 3대 배포면 S3_BUCKET 필수. 단일 호스트 시연에서만 ALLOW_LOCAL_STORAGE=true.
S3_BUCKET=<버킷 이름>
S3_PUBLIC_BASE=
AWS_REGION=ap-northeast-2
ALLOW_LOCAL_STORAGE=false
