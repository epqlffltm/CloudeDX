# .env.web.example
#
# 웹서버 3대에 배포한다. 복사해서 .env.web 으로 이름을 바꾸고 값을 채운다.
#
#     docker compose -f docker-compose.web.yml --env-file .env.web up -d
#
# 3대가 같은 값을 써야 하는 항목: DATABASE_URL, SESSION_SECRET

# ---------------------------------------------------------------------------
# DB (필수)
# ---------------------------------------------------------------------------
# Route 53 프라이빗 호스팅 영역의 이름을 쓴다. 주 DB 장애로 대기 DB 를 승격하면
# 그 레코드만 바꾸면 되고, 이 파일은 건드리지 않는다.
#
# 조립하지 않고 통째로 넣는 이유가 이것이다 — 호스트만 바뀌는 게 아니라
# "어디를 가리키는지"를 DNS 에 위임하기 위해서다.
DATABASE_URL=postgresql+asyncpg://cloudedx:<비밀번호>@db.reluxe.internal:5432/cloudedx

# ---------------------------------------------------------------------------
# 세션 (필수 · 3대 동일)
# ---------------------------------------------------------------------------
# 로그인 상태는 서버에 저장되지 않고 HMAC 서명 쿠키에만 담긴다. 그래서 ALB
# 스티키 세션은 필요 없지만, 그것은 3대가 같은 키로 서명한다는 전제 위에서만
# 성립한다. 키가 다르면 요청이 다른 서버로 갈 때마다 로그인이 풀린다.
#
#     openssl rand -hex 32
SESSION_SECRET=

# 로그인 유지 시간(초). 기본 12시간.
SESSION_MAX_AGE_SECONDS=43200

# ---------------------------------------------------------------------------
# 이미지
# ---------------------------------------------------------------------------
# ECR 을 붙이면 태그를 커밋 해시로 둔다. 어느 커밋이 떠 있는지 확인할 수 있고
# 롤백이 태그 교체로 끝난다.
#     WEB_IMAGE=<계정>.dkr.ecr.ap-northeast-2.amazonaws.com/reluxe-web:<커밋해시>
WEB_IMAGE=reluxe-web:latest
BACKEND_IMAGE=reluxe-backend:latest

# ---------------------------------------------------------------------------
# 네트워크
# ---------------------------------------------------------------------------
# X-Forwarded-For 를 믿어줄 대역. 체인이 두 단계라 둘 다 필요하다:
#   클라이언트 → ALB(VPC 대역) → nginx(도커 대역) → uvicorn
# VPC 대역은 실제 값으로 바꾼다.
FORWARDED_ALLOW_IPS=172.28.0.0/16,10.0.0.0/16

# 화면과 API 를 같은 출처에서 내보내므로 보통 비워둔다.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# 기타
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880
